####
# This Dockerfile builds a GraalVM native image for the storage service.
# Native images provide faster startup, lower memory footprint, and smaller container size.
#
# Prerequisites:
#   - Code must be GraalVM compatible (no reflection without configuration)
#   - Build requires significant memory (8GB+ recommended)
#
# Build with:
#   docker build -f Dockerfile.native -t storage-service:native .
#
# Run with:
#   docker run -i --rm -p 8080:8080 storage-service:native
#
# Note: Native compilation takes several minutes. For faster builds during development,
# use Dockerfile.jvm instead.
####

####
# Build stage using Quarkus native builder image
####
FROM quay.io/quarkus/ubi-quarkus-mandrel-builder-image:jdk-21 AS builder

WORKDIR /build

# Copy Gradle configuration
COPY --chown=quarkus:quarkus gradle gradle
COPY --chown=quarkus:quarkus gradlew .
COPY --chown=quarkus:quarkus settings.gradle.kts .
COPY --chown=quarkus:quarkus gradle.properties .
COPY --chown=quarkus:quarkus gradle/libs.versions.toml gradle/libs.versions.toml

# Copy application source
COPY --chown=quarkus:quarkus storage-service/rustfs-server/build.gradle.kts storage-service/rustfs-server/
COPY --chown=quarkus:quarkus storage-service/rustfs-server/src storage-service/rustfs-server/src

USER quarkus

# Build native executable
# -Dquarkus.native.container-build=false because we're already in a container
RUN ./gradlew :storage-service:rustfs-server:build \
  -Dquarkus.package.type=native \
  -Dquarkus.native.container-build=false \
  -Dquarkus.native.builder-image=false \
  --no-daemon

####
# Runtime stage using minimal UBI micro image
####
FROM registry.access.redhat.com/ubi9/ubi-minimal:9.5

# Install required runtime dependencies
RUN microdnf install -y shadow-utils && \
    groupadd -r appgroup && \
    useradd -r -g appgroup appuser && \
    microdnf clean all

WORKDIR /app

# Copy native executable
COPY --from=builder --chown=appuser:appgroup \
  /build/storage-service/rustfs-server/build/*-runner /app/application

# Switch to non-root user
USER appuser

# Expose application port
EXPOSE 8080

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://localhost:8080/q/health/live || exit 1

# Native images don't need JVM options
ENTRYPOINT ["./application"]

# Optional: Configure native image runtime options
# Uncomment to limit memory usage (e.g., for resource-constrained environments)
# ENV QUARKUS_NATIVE_MAX_HEAP_SIZE=256m
