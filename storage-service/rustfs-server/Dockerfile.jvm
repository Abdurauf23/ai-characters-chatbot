####
# This Dockerfile builds a JVM-based container image for the storage service.
# It uses a multi-stage build for optimal image size and security.
#
# Build with:
#   docker build -f Dockerfile.jvm -t storage-service:jvm .
#
# Run with:
#   docker run -i --rm -p 8080:8080 storage-service:jvm
####

FROM gradle:8.12-jdk21 AS builder

WORKDIR /build

# Copy Gradle configuration
COPY gradle gradle
COPY gradlew .
COPY settings.gradle.kts .
COPY gradle.properties .
COPY gradle/libs.versions.toml gradle/libs.versions.toml

# Copy application source
COPY storage-service/rustfs-server/build.gradle.kts storage-service/rustfs-server/
COPY storage-service/rustfs-server/src storage-service/rustfs-server/src

# Build the application
RUN ./gradlew :storage-service:rustfs-server:build -x test --no-daemon

####
# Runtime stage using Eclipse Temurin JRE
####
FROM eclipse-temurin:21-jre-alpine

ENV LANGUAGE='en_US:en'

# Configure container to run as non-root user
RUN addgroup -S appgroup && adduser -S appuser -G appgroup

WORKDIR /app

# Copy application files
COPY --from=builder --chown=appuser:appgroup \
  /build/storage-service/rustfs-server/build/quarkus-app/lib/ ./lib/
COPY --from=builder --chown=appuser:appgroup \
  /build/storage-service/rustfs-server/build/quarkus-app/*.jar ./
COPY --from=builder --chown=appuser:appgroup \
  /build/storage-service/rustfs-server/build/quarkus-app/app/ ./app/
COPY --from=builder --chown=appuser:appgroup \
  /build/storage-service/rustfs-server/build/quarkus-app/quarkus/ ./quarkus/

# Switch to non-root user
USER appuser

# Expose application port
EXPOSE 8080

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://localhost:8080/q/health/live || exit 1

# JVM tuning for container environments
ENV JAVA_OPTS="-XX:+UseContainerSupport -XX:MaxRAMPercentage=75.0 -XX:+ExitOnOutOfMemoryError"

ENTRYPOINT ["sh", "-c", "java $JAVA_OPTS -jar quarkus-run.jar"]
